[Unit]
Description=Vox voice dictation
Documentation=https://github.com/runsonmypc/vox
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vox
Restart=on-failure
RestartSec=3
# 78 (EX_CONFIG): Vox cannot run with this configuration, so restarting would only fail again
RestartPreventExitStatus=78
# History, logs and settings that Vox creates are readable only by the user
UMask=0077

[Install]
# Desktops whose session manager never reaches graphical-session.target (Xfce, MATE, most window
# managers) start Vox through the XDG autostart entry instead
WantedBy=graphical-session.target
