#!/bin/sh
# On removal, stop Vox for logged-in users and stop starting it at login
set -e

# Run `systemctl --user "$@"` in the service manager of every logged-in user
each_user_manager() {
    for dir in /run/user/*; do
        uid=${dir##*/}
        case "$uid" in '' | *[!0-9]*) continue ;; esac
        systemctl is-active --quiet "user@$uid.service" || continue
        user=$(getent passwd "$uid" | cut -d: -f1)
        [ -n "$user" ] || continue
        runuser -u "$user" -- env XDG_RUNTIME_DIR="$dir" systemctl --user "$@" || true
    done
}

if [ "$1" = remove ] && command -v systemctl >/dev/null 2>&1; then
    # Disable while the unit file still exists: systemctl reads its [Install] section
    systemctl --global disable vox.service || true
    if [ -d /run/systemd/system ]; then
        each_user_manager stop vox.service
    fi
fi
