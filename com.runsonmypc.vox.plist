<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.runsonmypc.vox</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>if [ -x "$HOME/.local/bin/vox" ]; then exec "$HOME/.local/bin/vox"; elif [ -x "$HOME/Developer/vox/start.sh" ]; then exec "$HOME/Developer/vox/start.sh"; else exec vox; fi</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/vox.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vox.stderr.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
